NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://imet:imet_local_only@localhost:5432/imet?schema=public
FRONTEND_URL=http://localhost:3000
# Run node scripts/init-local-env.mjs to generate local signing secrets.
JWT_SECRET=
# New accounts start as Buyers; supplier/manufacturer roles require admin approval.
PUBLIC_SIGNUP_ROLE=BUYER
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
# REDIS_PASSWORD=
# Configure securely before running the transactional email worker:
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# RFQ expiry and non-response reminder defaults (days):
RFQ_EXPIRY_DAYS=14
RFQ_REMINDER_DAYS=2
# Private Bunny Storage zone; do not attach a public CDN pull zone.
# BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
# BUNNY_STORAGE_ACCESS_KEY=
