NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://imet:imet_local_only@localhost:5432/imet?schema=public
FRONTEND_URL=http://localhost:3000
# Run node scripts/init-local-env.mjs to generate local signing secrets.
JWT_SECRET=
# New accounts start as Buyers; supplier/manufacturer roles require admin approval.
PUBLIC_SIGNUP_ROLE=BUYER
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
# REDIS_PASSWORD=
# Configure securely before running the transactional email worker:
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# RFQ expiry and non-response reminder defaults (days):
RFQ_EXPIRY_DAYS=14
RFQ_REMINDER_DAYS=2
# Private Bunny Storage zone; do not attach a public CDN pull zone.
# BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
# BUNNY_STORAGE_ACCESS_KEY=

# M8: server-only OpenAI Responses API; public generation is admin-controlled.
# Configure this key securely; never use NEXT_PUBLIC_ for credentials.
# AI_TRANSLATION_API_KEY=
AI_TRANSLATION_MODEL=gpt-4.1-mini
AI_TRANSLATION_TIMEOUT_MS=20000
AI_TRANSLATION_MAX_CHARACTERS=6000
# Global provider attempts per UTC day; cache reads and same-language use no quota.
AI_TRANSLATION_DAILY_LIMIT=50

# M1 Google: same OAuth web client ID as imet-client; no secret needed by API.
# GOOGLE_CLIENT_ID=
