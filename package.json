{
  "name": "imet-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "worker": "tsx src/emails/worker.ts",
    "worker:prod": "node dist/emails/worker.js",
    "admin:create": "tsx scripts/create-admin.ts",
    "env:init": "node scripts/init-local-env.mjs",
    "worker:rfq": "tsx src/modules/rfq/rfq.worker.ts",
    "worker:rfq:prod": "node dist/modules/rfq/rfq.worker.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.5",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "file-type": "^21.3.4",
    "helmet": "8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "8.17.2",
    "resend": "^6.32.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24",
    "@types/pg": "^8",
    "eslint": "^9",
    "prettier": "^3",
    "prisma": "7.10.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8"
  },
  "overrides": {
    "mysql2": "3.24.5"
  }
}
