generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  LOCAL_SUPPLIER
  INTERNATIONAL_MANUFACTURER
  SALES_PERSON
  INDEPENDENT_SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id                         String               @id @default(uuid())
  email                      String               @unique @db.VarChar(254)
  displayName                String               @db.VarChar(100)
  password                   String
  status                     UserStatus           @default(PENDING_VERIFICATION)
  isEmailVerified            Boolean              @default(false)
  emailVerificationTokenHash String?              @unique
  emailVerificationExpires   DateTime?
  passwordResetTokenHash     String?              @unique
  passwordResetExpires       DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  supplier                   Supplier?
  assignedRole               UserRoleAssignment[]
  sessions                   UserSession[]
  rfqs                       Rfq[]                @relation("RfqBuyer")
  rfqRecipients              RfqRecipient[]
  rfqUploads                 RfqAttachment[]
  quoteUploads               RfqQuoteAttachment[]
  rfqMessages                RfqMessage[]
  rfqEvents                  RfqEvent[]
  rfqEmailDeliveries         RfqEmailDelivery[]
  salesEvents                SalesEvent[]
  recordedSales              SaleRecord[]
  authoredReviews            Review[]             @relation("ReviewAuthor")
  moderatedReviews           Review[]             @relation("ReviewModerator")

  @@index([status])
  @@map("users")
}

model UserRoleAssignment {
  userId String
  role   UserRole
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_role_assignments")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

// Public catalogue contains no price or supplier contact fields.
enum MachineStatus {
  DRAFT
  PUBLISHED
}

model MachineCategory {
  id       String    @id @default(uuid())
  name     String    @db.VarChar(100)
  slug     String    @unique @db.VarChar(120)
  machines Machine[]
  rfqs     Rfq[]

  @@map("machine_categories")
}

model Machine {
  reviews        Review[]
  id             String                 @id @default(uuid())
  name           String                 @db.VarChar(200)
  slug           String                 @unique @db.VarChar(220)
  description    String
  manufacturer   String                 @db.VarChar(200)
  model          String                 @db.VarChar(200)
  supplierId     String?
  supplier       Supplier?              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  categoryId     String
  category       MachineCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status         MachineStatus          @default(DRAFT)
  images         MachineImage[]
  specifications MachineSpecification[]
  rfqs           Rfq[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([supplierId, status])
  @@index([status, categoryId, name, id])
  @@map("machines")
}

model MachineImage {
  id        String  @id @default(uuid())
  machineId String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @db.VarChar(250)
  position  Int     @default(0)

  @@index([machineId, position])
  @@map("machine_images")
}

model MachineSpecification {
  id        String  @id @default(uuid())
  machineId String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  label     String  @db.VarChar(100)
  value     String  @db.VarChar(500)
  position  Int     @default(0)

  @@index([machineId, position])
  @@map("machine_specifications")
}

enum SupplierType {
  LOCAL
  INTERNATIONAL
}

enum SupplierStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  INACTIVE
}

enum SubscriptionState {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum MarketplaceVisibility {
  HIDDEN
  STANDARD
  FEATURED
}

model Supplier {
  reviews            Review[]
  id                 String                 @id @default(uuid())
  userId             String                 @unique
  user               User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  companyName        String                 @db.VarChar(200)
  type               SupplierType
  description        String
  contactName        String                 @db.VarChar(100)
  businessEmail      String                 @db.VarChar(254)
  businessPhone      String                 @db.VarChar(40)
  address            String                 @db.VarChar(2000)
  city               String                 @db.VarChar(100)
  country            String                 @db.VarChar(100)
  registrationNumber String?                @db.VarChar(150)
  website            String?
  logoUrl            String?
  documents          Json
  status             SupplierStatus         @default(PENDING)
  isVerified         Boolean                @default(false)
  marketplaceVisible Boolean                @default(false)
  contactBlocked     Boolean                @default(false)
  reviewNote         String?                @db.VarChar(2000)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  subscriptions      SupplierSubscription[]
  machines           Machine[]

  @@index([status, marketplaceVisible])
  @@map("suppliers")
}

model SubscriptionPlan {
  id                  String                 @id @default(uuid())
  name                String                 @db.VarChar(100)
  eligibleTypes       SupplierType[]
  durationDays        Int
  price               Decimal                @db.Decimal(12, 2)
  currency            String                 @db.VarChar(3)
  listingLimit        Int
  imageLimit          Int
  specificationLimit  Int
  rfqEnabled          Boolean                @default(false)
  leadLimitPerMonth   Int?                   @default(0)
  canRevealContacts   Boolean                @default(false)
  canPublishMachinery Boolean
  visibility          MarketplaceVisibility
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  subscriptions       SupplierSubscription[]

  @@map("subscription_plans")
}

model SupplierSubscription {
  id                  String                @id @default(uuid())
  supplierId          String
  supplier            Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  planId              String
  plan                SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  isCurrent           Boolean               @default(true)
  state               SubscriptionState
  startsAt            DateTime
  endsAt              DateTime
  planName            String                @db.VarChar(100)
  supplierType        SupplierType
  durationDays        Int
  price               Decimal               @db.Decimal(12, 2)
  currency            String                @db.VarChar(3)
  listingLimit        Int
  imageLimit          Int
  specificationLimit  Int
  rfqEnabled          Boolean               @default(false)
  leadLimitPerMonth   Int?                  @default(0)
  canRevealContacts   Boolean               @default(false)
  canPublishMachinery Boolean
  visibility          MarketplaceVisibility
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([supplierId, isCurrent, state, startsAt, endsAt])
  @@map("supplier_subscriptions")
}

// RFQ prices and contacts are private; services must use role-aware projections.
enum RfqStatus {
  DRAFT
  SUBMITTED
  ROUTED
  QUOTED
  ACCEPTED
  CLOSED
  CANCELLED
  EXPIRED
  DECLINED
}

enum LeadStatus {
  NEW
  VIEWED
  QUOTED
  DECLINED
  CLOSED
}

enum RfqRecipientRole {
  SUPPLIER
  MANUFACTURER
  SALESPERSON
  SELLER
}

enum RfqRoutingReason {
  AUTO
  MANUAL
  ADMIN_OVERRIDE
}

enum RfqQuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum RfqEmailStatus {
  PENDING
  QUEUED
  SENT
  FAILED
}

model Rfq {
  id                String           @id @default(uuid())
  sequence          Int              @unique @default(autoincrement())
  rfqNumber         String           @unique @db.VarChar(40)
  buyerId           String
  buyer             User             @relation("RfqBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  machineId         String?
  machine           Machine?         @relation(fields: [machineId], references: [id], onDelete: SetNull)
  categoryId        String?
  category          MachineCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title             String           @db.VarChar(200)
  description       String
  quantity          Decimal          @db.Decimal(14, 3)
  unit              String           @db.VarChar(40)
  targetBudget      Decimal?         @db.Decimal(16, 2)
  budgetCurrency    String?          @db.VarChar(3)
  deliveryLocation  String           @db.VarChar(2000)
  deliveryTimeline  String           @db.VarChar(500)
  supplierCountry   String?          @db.VarChar(100)
  preferredLanguage String           @default("en") @db.VarChar(2)
  status            RfqStatus        @default(DRAFT)
  expiresAt         DateTime?
  submittedAt       DateTime?
  isFlagged         Boolean          @default(false)
  flagReason        String?          @db.VarChar(2000)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  attachments       RfqAttachment[]
  recipients        RfqRecipient[]
  quotes            RfqQuote[]
  messages          RfqMessage[]
  events            RfqEvent[]

  @@index([buyerId, createdAt, id])
  @@index([status, expiresAt])
  @@index([categoryId, createdAt])
  @@map("rfqs")
}

model RfqRecipient {
  id             String            @id @default(uuid())
  rfqId          String
  rfq            Rfq               @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  recipientId    String
  recipient      User              @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  recipientRole  RfqRecipientRole
  leadStatus     LeadStatus        @default(NEW)
  routingReason  RfqRoutingReason
  routedAt       DateTime          @default(now())
  viewedAt       DateTime?
  respondedAt    DateTime?
  removedAt      DateTime?
  quotaMonth     DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  quotes         RfqQuote[]
  messages       RfqMessage[]
  opportunity    SalesOpportunity?

  @@unique([rfqId, recipientId])
  @@unique([id, rfqId])
  @@index([recipientId, leadStatus, routedAt])
  @@index([recipientId, quotaMonth])
  @@map("rfq_recipients")
}

model RfqQuote {
  id           String               @id @default(uuid())
  rfqId        String
  rfq          Rfq                  @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  recipientId  String
  recipient    RfqRecipient         @relation(fields: [recipientId, rfqId], references: [id, rfqId], onDelete: Restrict)
  unitPrice    Decimal              @db.Decimal(16, 2)
  currency     String               @db.VarChar(3)
  moq          Decimal              @db.Decimal(14, 3)
  leadTimeDays Int
  validUntil   DateTime
  notes        String
  status       RfqQuoteStatus       @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  attachments  RfqQuoteAttachment[]
  sale         SaleRecord?

  @@unique([id, recipientId])
  @@index([rfqId, status])
  @@index([recipientId, createdAt])
  @@map("rfq_quotes")
}

model RfqAttachment {
  id           String   @id @default(uuid())
  rfqId        String
  rfq          Rfq      @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  storageKey   String   @unique
  fileName     String   @db.VarChar(250)
  fileType     String   @db.VarChar(100)
  fileSize     Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([rfqId])
  @@map("rfq_attachments")
}

model RfqQuoteAttachment {
  id           String   @id @default(uuid())
  quoteId      String
  quote        RfqQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  storageKey   String   @unique
  fileName     String   @db.VarChar(250)
  fileType     String   @db.VarChar(100)
  fileSize     Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([quoteId])
  @@map("rfq_quote_attachments")
}

model RfqMessage {
  id          String       @id @default(uuid())
  rfqId       String
  rfq         Rfq          @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  recipientId String
  recipient   RfqRecipient @relation(fields: [recipientId, rfqId], references: [id, rfqId], onDelete: Restrict)
  senderId    String
  sender      User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body        String
  createdAt   DateTime     @default(now())
  readAt      DateTime?

  @@index([recipientId, createdAt, id])
  @@map("rfq_messages")
}

model RfqEvent {
  id         String             @id @default(uuid())
  rfqId      String
  rfq        Rfq                @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  actorId    String?
  actor      User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  eventType  String             @db.VarChar(100)
  metadata   Json
  createdAt  DateTime           @default(now())
  deliveries RfqEmailDelivery[]

  @@index([rfqId, createdAt, id])
  @@map("rfq_events")
}

// Durable email intents connect committed audit events to the existing email queue.
model RfqEmailDelivery {
  id        String         @id @default(uuid())
  eventId   String
  event     RfqEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  status    RfqEmailStatus @default(PENDING)
  attempts  Int            @default(0)
  lastError String?        @db.VarChar(500)
  queuedAt  DateTime?
  sentAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([eventId, userId])
  @@index([status, createdAt])
  @@map("rfq_email_deliveries")
}

enum SalesStage {
  NEW
  QUALIFIED
  QUOTED
  NEGOTIATION
  WON
  LOST
}

enum SaleStatus {
  RECORDED
  COMPLETED
  CANCELLED
}

model SalesOpportunity {
  id            String       @id @default(uuid())
  recipientId   String       @unique
  recipient     RfqRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  stage         SalesStage   @default(NEW)
  internalNotes String       @default("") @db.VarChar(5000)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  events        SalesEvent[]
  sale          SaleRecord?

  @@unique([id, recipientId])
  @@index([stage, updatedAt, id])
  @@map("sales_opportunities")
}

model SaleRecord {
  reviews            Review[]
  id                 String           @id @default(uuid())
  opportunityId      String           @unique
  recipientId        String
  opportunity        SalesOpportunity @relation(fields: [opportunityId, recipientId], references: [id, recipientId], onDelete: Restrict)
  acceptedQuoteId    String           @unique
  acceptedQuote      RfqQuote         @relation(fields: [acceptedQuoteId, recipientId], references: [id, recipientId], onDelete: Restrict)
  status             SaleStatus       @default(RECORDED)
  recordedById       String
  recordedBy         User             @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  cancellationReason String?          @db.VarChar(2000)
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([opportunityId, recipientId])
  @@unique([acceptedQuoteId, recipientId])
  @@index([status, createdAt, id])
  @@map("sale_records")
}

model SalesEvent {
  id            String           @id @default(uuid())
  opportunityId String
  opportunity   SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  actorId       String?
  actor         User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  eventType     String           @db.VarChar(100)
  metadata      Json
  createdAt     DateTime         @default(now())

  @@index([opportunityId, createdAt, id])
  @@map("sales_events")
}

enum ReviewTarget {
  MACHINERY
  SUPPLIER
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
  WITHDRAWN
}

model Review {
  id             String       @id @default(uuid())
  saleId         String
  sale           SaleRecord   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  authorId       String
  author         User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  target         ReviewTarget
  machineId      String?
  machine        Machine?     @relation(fields: [machineId], references: [id], onDelete: Restrict)
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  rating         Int
  body           String       @db.VarChar(5000)
  status         ReviewStatus @default(PENDING)
  moderationNote String?      @db.VarChar(2000)
  moderatedById  String?
  moderatedBy    User?        @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([saleId, target])
  @@index([authorId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([machineId, status, createdAt, id])
  @@index([supplierId, status, createdAt, id])
  @@map("reviews")
}
